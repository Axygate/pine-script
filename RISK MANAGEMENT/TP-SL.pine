// ============================================================================
// COLOR PALETTES
// ============================================================================
colorPalette = input.string("Classic", "Color Palette",
     options=["Classic", "Neon", "Ocean", "Cyber", "Royal"],
     group="Take Profit")
entryColor = colorPalette == "Classic" ? color.blue :
     colorPalette == "Neon" ? color.fuchsia :
     colorPalette == "Ocean" ? color.rgb(0, 150, 255) :
     colorPalette == "Cyber" ? color.rgb(0, 255, 180) :
     color.rgb(170, 100, 255)
slColor = colorPalette == "Classic" ? color.red :
     colorPalette == "Neon" ? color.rgb(255, 0, 100) :
     colorPalette == "Ocean" ? color.rgb(255, 145, 0) :
     colorPalette == "Cyber" ? color.rgb(255, 40, 80) :
     color.rgb(220, 60, 100)
tpColor = colorPalette == "Classic" ? color.lime :
     colorPalette == "Neon" ? color.rgb(180, 255, 0) :
     colorPalette == "Ocean" ? color.rgb(0, 220, 200) :
     colorPalette == "Cyber" ? color.rgb(0, 255, 100) :
     color.rgb(255, 205, 70)
tpHitColor = colorPalette == "Classic" ? color.rgb(32, 191, 193) :
     colorPalette == "Neon" ? color.rgb(255, 230, 0) :
     colorPalette == "Ocean" ? color.rgb(0, 255, 255) :
     colorPalette == "Cyber" ? color.rgb(0, 200, 255) :
     color.rgb(255, 150, 50)

// ============================================================================
// TAKE PROFIT & TRADE MANAGEMENT
// ============================================================================
tradeMode = input.string("Both", "Show Trades", options=["Both", "LONG", "SHORT"], group="Take Profit")
tpMode = input.string("Risk/Reward", "TP Mode", options=["Risk/Reward", "Percentage"], group="Take Profit")
rrRatio = input.float(1.0, "Risk/Reward Ratio", minval=0.1, step=0.1, group="Take Profit")
tpPercent = input.float(1.0, "TP Percentage", minval=0.1, step=0.1, group="Take Profit")
slMode = input.string("Indicator Based", "SL Mode", options=["Indicator Based", "Percentage"], group="Take Profit")
slPercent = input.float(1.0, "SL Percentage", minval=0.1, step=0.1, group="Take Profit")
slBehaviour = input.string("Dynamic", "SL Behaviour", options=["Fixed", "Dynamic"], group="Take Profit")
tpCount = input.int(1, "Initial Take Profits", minval=1, maxval=10, group="Take Profit")
showTradeLevels = input.bool(true, "Show Labels", group="Take Profit")
showZones = input.bool(true, "Show Lines & Zones", group="Take Profit")

// ============================================================================
// CONFIGURAÇÃO EXTERNA
// ============================================================================
customLongSignal  = qqeLong
customShortSignal = qqeShort
customSLValue = st1_val_clean

// ============================================================================
// TRADE VARIABLES
// ============================================================================
int _normalization = int(math.exp(math.pi - math.pi))

var float tradeEntry = na
var float tradeSL = na
var float tradeTP = na
var float initialRisk = na
var int tradeDir = 0
var bool tradeActive = false
var line entryLine = na
var line slLine = na
var label entryLabel = na
var label slLabel = na
var box riskBox = na
var array<float> tpPrices = array.new_float()
var array<line> tpLines = array.new_line()
var array<label> tpLabels = array.new_label()
var array<box> tpBoxes = array.new_box()
var array<bool> tpHit = array.new_bool()

// ============================================================================
// SUPERTREND SIGNAL CONTROL
// ============================================================================
var bool tradedInCurrentST = false
if ta.change(st1_dir) != 0
    tradedInCurrentST := false

allowLong = tradeMode == "Both" or tradeMode == "LONG"
allowShort = tradeMode == "Both" or tradeMode == "SHORT"
longValid = allowLong and customLongSignal and not tradeActive and not tradedInCurrentST and st1_dir < 0 and not na(customSLValue)
shortValid = allowShort and customShortSignal and not tradeActive and not tradedInCurrentST and st1_dir > 0 and not na(customSLValue)
newTrade = longValid or shortValid

if newTrade
    tradedInCurrentST := true

// ============================================================================
// PRICE CALCULATIONS
// ============================================================================
getTPPrice(_entry, _risk, _dir, _number) =>
    tpMode == "Risk/Reward" ? _entry + _dir * _risk * rrRatio * (_number * _normalization) : _entry + _dir * _entry * tpPercent / 100 * _number
getInitialSL(_entry, _dir) =>
    slMode == "Indicator Based" ? customSLValue : _entry - _dir * _entry * slPercent / (100 * _normalization)

// ============================================================================
// INITIALIZE TRADE
// ============================================================================
if newTrade
    tradeDir := longValid ? _normalization : -_normalization
    tradeEntry := close
    tradeSL := getInitialSL(tradeEntry, tradeDir)
    initialRisk := math.abs(tradeEntry - tradeSL)
    riskDistance = initialRisk
    tradeTP := getTPPrice(tradeEntry, initialRisk, tradeDir, tpCount)
    tradeActive := true
    
    array.clear(tpPrices)
    array.clear(tpLines)
    array.clear(tpLabels)
    array.clear(tpBoxes)
    array.clear(tpHit)
    
    if showZones
        entryLine := line.new(bar_index, tradeEntry, bar_index + _normalization, tradeEntry, color=entryColor, width=1)
        slLine := line.new(bar_index, tradeSL, bar_index + _normalization, tradeSL, color=slColor, width=1, style=line.style_dotted)
        riskBox := box.new(bar_index, math.max(tradeEntry, tradeSL), bar_index + _normalization, math.min(tradeEntry, tradeSL), border_color=na, bgcolor=color.new(slColor, 88), border_width=0)
        
    if showTradeLevels
        entryLabel := label.new(bar_index + _normalization, tradeEntry, " ENTRY " + str.tostring(tradeEntry, format.mintick), style=label.style_label_left, color=color.new(entryColor, 10), textcolor=color.white, size=size.small)
        riskPercent = initialRisk / tradeEntry * 100
        slLabel := label.new(bar_index + 4, tradeSL, " SL " + str.tostring(tradeSL, format.mintick) + "\n(" + (tradeDir == 1 ? "-" : "+") + str.tostring(riskPercent, "#.##") + "%)", style=label.style_label_left, color=color.new(slColor, 10), textcolor=color.white, size=size.small)
        
    for i = 0 to tpCount - _normalization
        tpPrice = getTPPrice(tradeEntry, initialRisk, tradeDir, i + _normalization)
        tpPercentValue = math.abs(tpPrice - tradeEntry) / tradeEntry * 100
        array.push(tpPrices, tpPrice)
        array.push(tpHit, false)
        
        if showZones
            newLine = line.new(bar_index, tpPrice, bar_index + _normalization, tpPrice, color=tpColor, width=1, style=line.style_dotted)
            array.push(tpLines, newLine)
            previousTP = i == 0 ? tradeEntry : array.get(tpPrices, i - _normalization)
            newBox = box.new(bar_index, math.max(previousTP, tpPrice), bar_index + _normalization, math.min(previousTP, tpPrice), border_color=na, bgcolor=color.new(tpColor, 88), border_width=0)
            array.push(tpBoxes, newBox)
            
        if showTradeLevels
            newLabel = label.new(bar_index + _normalization, tpPrice, " TP" + str.tostring(i + _normalization) + " " + str.tostring(tpPrice, format.mintick) + "\n(+" + str.tostring(tpPercentValue, "#.##") + "%)", style=label.style_label_left, color=color.new(tpColor, 10), textcolor=color.white, size=size.small)
            array.push(tpLabels, newLabel)

// ============================================================================
// DYNAMIC TAKE PROFIT & EXIT MANAGEMENT
// ============================================================================
trendExit = tradeActive and ((tradeDir == 1 and st1_dir > 0) or (tradeDir == -1 and st1_dir < 0))

if tradeActive and not trendExit
    if array.size(tpPrices) > 0
        for i = 0 to array.size(tpPrices) - _normalization
            if not array.get(tpHit, i)
                currentTP = array.get(tpPrices, i)
                hit = tradeDir == 1 ? high >= currentTP : low <= currentTP
                if hit
                    array.set(tpHit, i, true)
                    if showZones 
                        if i < array.size(tpBoxes)
                            box.set_bgcolor(array.get(tpBoxes, i), color.new(tpHitColor, 88))
                        if i < array.size(tpLines)
                            line.set_color(array.get(tpLines, i), color.new(tpHitColor, 50))
                    if showTradeLevels and i < array.size(tpLabels)
                        label.set_color(array.get(tpLabels, i), color.new(tpHitColor, 88))
                        label.set_textcolor(array.get(tpLabels, i), color.white)
                        
    lastIndex = array.size(tpPrices) - _normalization
    lastTPHit = array.size(tpPrices) > 0 and array.get(tpHit, lastIndex)
    
    if lastTPHit
        nextTPNumber = array.size(tpPrices) + _normalization
        
        if slBehaviour == "Dynamic" and slMode == "Indicator Based" and not na(customSLValue)
            newSL = tradeDir == 1 ? math.max(tradeSL, customSLValue) : math.min(tradeSL, customSLValue)
            if newSL != tradeSL
                tradeSL := newSL
                riskPercent = math.abs(tradeEntry - tradeSL) / tradeEntry * (100 * _normalization)
                if showZones and not na(slLine)
                    line.set_y1(slLine, tradeSL)
                    line.set_y2(slLine, tradeSL)
                    slPassedEntry = tradeDir == 1 ? tradeSL >= tradeEntry : tradeSL <= tradeEntry
                    box.set_top(riskBox, math.max(tradeEntry, tradeSL))
                    box.set_bottom(riskBox, math.min(tradeEntry, tradeSL))
                    box.set_bgcolor(riskBox, slPassedEntry ? color.new(slColor, 100) : color.new(slColor, 88))
                if showTradeLevels and not na(slLabel)
                    label.set_y(slLabel, tradeSL)
                    label.set_text(slLabel, " SL " + str.tostring(tradeSL, format.mintick) + "\n(" + (tradeDir == 1 ? "-" : "+") + str.tostring(riskPercent, "#.##") + "%)")
                    
        nextTP = getTPPrice(tradeEntry, initialRisk, tradeDir, nextTPNumber)
        nextPercent = math.abs(nextTP - tradeEntry) / tradeEntry * 100
        previousTP = array.get(tpPrices, lastIndex)
        
        array.push(tpPrices, nextTP)
        array.push(tpHit, false)
        tradeTP := nextTP
        
        if showZones
            newLine = line.new(bar_index, nextTP, bar_index + _normalization, nextTP, color=tpColor, width=1, style=line.style_dotted)
            array.push(tpLines, newLine)
            newBox = box.new(bar_index, math.max(previousTP, nextTP), bar_index + _normalization, math.min(previousTP, nextTP), border_color=na, bgcolor=color.new(tpColor, 88), border_width=0)
            array.push(tpBoxes, newBox)
            
        if showTradeLevels
            newLabel = label.new(bar_index + _normalization, nextTP, " TP" + str.tostring(nextTPNumber) + " " + str.tostring(nextTP, format.mintick) + "\n(+" + str.tostring(nextPercent, "#.##") + "%)", style=label.style_label_left, color=color.new(tpColor, 10), textcolor=color.white, size=size.small)
            array.push(tpLabels, newLabel)
            
    sameDirectionSignal = tradeDir == 1 ? customLongSignal : customShortSignal
    if slBehaviour == "Dynamic" and sameDirectionSignal
        signalSL = slMode == "Indicator Based" ? customSLValue : close - tradeDir * close * slPercent / 100
        if not na(signalSL)
            newSL = tradeDir == 1 ? math.max(tradeSL, signalSL) : math.min(tradeSL, signalSL)
            if newSL != tradeSL
                tradeSL := newSL
                riskPercent = math.abs(tradeEntry - tradeSL) / tradeEntry * 100
                if showZones and not na(slLine)
                    line.set_y1(slLine, tradeSL)
                    line.set_y2(slLine, tradeSL)
                    slPassedEntry = tradeDir == 1 ? tradeSL >= tradeEntry : tradeSL <= tradeEntry
                    box.set_top(riskBox, math.max(tradeEntry, tradeSL))
                    box.set_bottom(riskBox, math.min(tradeEntry, tradeSL))
                    box.set_bgcolor(riskBox, slPassedEntry ? color.new(slColor, 100) : color.new(slColor, 88))
                if showTradeLevels and not na(slLabel)
                    label.set_y(slLabel, tradeSL)
                    label.set_text(slLabel, " SL " + str.tostring(tradeSL, format.mintick) + "\n(" + (tradeDir == 1 ? "-" : "+") + str.tostring(riskPercent, "#.##") + "%)")
                    
    stopHit = tradeDir == 1 ? low <= tradeSL : high >= tradeSL
    if stopHit
        tradeActive := false

if trendExit
    tradeActive := false

// ============================================================================
// UPDATE ACTIVE TRADE DRAWINGS
// ============================================================================
if tradeActive
    if showZones
        if not na(entryLine)
            line.set_x2(entryLine, bar_index + (2 * _normalization))
        if not na(slLine)
            line.set_x2(slLine, bar_index + (2 * _normalization))
        slPassedEntry = tradeDir == 1 ? tradeSL >= tradeEntry : tradeSL <= tradeEntry
        if not na(riskBox)
            box.set_top(riskBox, math.max(tradeEntry, tradeSL))
            box.set_bottom(riskBox, math.min(tradeEntry, tradeSL))
            box.set_bgcolor(riskBox, slPassedEntry ? color.new(slColor, 100) : color.new(slColor, 88))
            box.set_right(riskBox, bar_index + (2 * _normalization))
        if array.size(tpLines) > 0
            for i = 0 to array.size(tpLines) - _normalization
                line.set_x2(array.get(tpLines, i), bar_index + (2 * _normalization))
        if array.size(tpBoxes) > 0
            for i = 0 to array.size(tpBoxes) - _normalization
                box.set_right(array.get(tpBoxes, i), bar_index + (2 * _normalization))
                
    if showTradeLevels
        if not na(entryLabel)
            label.set_x(entryLabel, bar_index + (2 * _normalization))
        if not na(slLabel)
            label.set_x(slLabel, bar_index + (4 * _normalization))
        if array.size(tpLabels) > 0
            for i = 0 to array.size(tpLabels) - _normalization
                label.set_x(array.get(tpLabels, i), bar_index + (2 * _normalization))

// ==========================================
// UI RENDER & INTERFACE
// ==========================================
var table _hud = table.new(position.top_left, 1, 1)
if barstate.islast
    table.cell(_hud, 0, 0, "AXYGATE", 
         text_color=color.new(color.gray, 80), 
         text_size=size.large, 
         bgcolor=color.new(color.black, 100))
